# ScorchePay backend. Copy to .env and fill in.

PORT=8080
# Public address of this server, used in bill link URLs.
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://USER@localhost:5432/scorchepay_backend
# 32+ random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Guards /admin/*. Another long random string.
ADMIN_TOKEN=

# Development only: accepted for every sign-up code, and codes are logged
# rather than sent. Leave empty in production (and add an SMS sender).
OTP_DEV_CODE=123456
# Development only: lets anyone mark an unpaid order paid without Lightning
# (POST /v1/dev/orders/{id}/simulate-payment), for testing the app and
# Swagger. Never enable in production.
DEV_SIMULATE_PAYMENTS=false

# Lightning node (Mutinynet signet). Keep LDK_STORAGE_DIR backed up: it
# holds the node's seed and channel state.
LDK_STORAGE_DIR=./data/ldk
LDK_LISTEN_PORT=9735
# signet (Mutinynet) | regtest
BITCOIN_NETWORK=signet
ESPLORA_URL=https://mutinynet.com/api
# Optional: read the chain from Bitcoin Core (user:pass@host:port) instead.
BITCOIND_RPC=
RGS_URL=https://rgs.mutinynet.com/snapshot/

# Pricing. Spread in basis points (150 = 1.5%); quotes last QUOTE_SECS.
SPREAD_BPS=150
QUOTE_SECS=120
# BTC/NGN comes from CoinGecko, then CoinPaprika, then Blockchain.com. A
# CoinGecko demo key (free) gives higher rate limits; it's optional.
COINGECKO_API_KEY=
# Development only: a made-up price used when no live source answers, so
# you can work offline. It is NOT the market. Leave it empty anywhere real
# money moves, and when testing prices: it hides a broken feed.
FALLBACK_NGN_PER_BTC=

# Airtime and data: fake | smeplug. SMEPlug has no sandbox, so `smeplug`
# spends real naira from its wallet.
VTU_PROVIDER=fake
SMEPLUG_API_KEY=
DATA_MARKUP_PERCENT=5
# Electricity and TV: fake | off (N3TData comes next).
BILLS_PROVIDER=fake

# KYC: fake | mono. Fake approves tier 1 after two seconds.
KYC_PROVIDER=fake
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
MONO_REDIRECT_URL=
