# ScorchePay backend. Copy to .env and fill in.

PORT=8080
# Public address of this server, used in bill link URLs.
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://USER@localhost:5432/scorchepay_backend
# 32+ random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Guards /admin/*. Another long random string.
ADMIN_TOKEN=

# Development only: accepted for every sign-up code, and codes are logged
# rather than sent. Leave empty in production (and add an SMS sender).
OTP_DEV_CODE=123456
# Development only: lets anyone mark an unpaid order paid without Lightning
# (POST /v1/dev/orders/{id}/simulate-payment) and make throwaway demo
# accounts (POST /v1/dev/demo-account), for testing the app, Swagger and
# the web pages. Never enable in production.
DEV_SIMULATE_PAYMENTS=false

# Lightning node (Mutinynet signet). Keep LDK_STORAGE_DIR backed up: it
# holds the node's seed and channel state.
LDK_STORAGE_DIR=./data/ldk
LDK_LISTEN_PORT=9735
# signet (Mutinynet) | regtest
BITCOIN_NETWORK=signet
ESPLORA_URL=https://mutinynet.com/api
# Optional: read the chain from Bitcoin Core (user:pass@host:port) instead.
BITCOIND_RPC=
RGS_URL=https://rgs.mutinynet.com/snapshot/

# Pricing. Spread in basis points (150 = 1.5%); quotes last QUOTE_SECS.
SPREAD_BPS=150
QUOTE_SECS=120
# BTC/NGN comes from CoinGecko, then CoinPaprika, then Blockchain.com. A
# CoinGecko demo key (free) gives higher rate limits; it's optional.
COINGECKO_API_KEY=
# Development only: a made-up price used when no live source answers, so
# you can work offline. It is NOT the market. Leave it empty anywhere real
# money moves, and when testing prices: it hides a broken feed.
FALLBACK_NGN_PER_BTC=

# Airtime and data: fake | smeplug. SMEPlug has no sandbox, so `smeplug`
# spends real naira from its wallet.
VTU_PROVIDER=fake
SMEPLUG_API_KEY=
DATA_MARKUP_PERCENT=5
# Electricity and TV: fake | off (N3TData comes next).
BILLS_PROVIDER=fake

# KYC: fake | mono. Fake approves tier 1 after two seconds.
KYC_PROVIDER=fake
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
MONO_REDIRECT_URL=

# --- Optional: an AI model for the bill helper -------------------------------
# The helper reads most requests with plain rules (free, instant). With a model
# configured it also understands misspellings, garbled speech and Yoruba/Igbo,
# and asks a short question when something is missing. Any OpenAI-compatible API
# works. Phone, meter and smartcard numbers are masked before anything is sent.
# Free options:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=openai/gpt-oss-20b   (Groq retires models; check https://console.groq.com/docs/models)
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1              LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1  (no key)       LLM_MODEL=llama3.2
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b   (Groq retires models; check https://console.groq.com/docs/models)

# --- Optional: a natural voice for the voice assistant -----------------------
# Phones' built-in text-to-speech sounds robotic. Point this at any
# OpenAI-compatible /audio/speech API and the app plays that voice instead
# (and falls back to the phone's voice if it is down). Free, no key:
#   pip install edge-tts && python3 scripts/free-tts-server.py
# which serves Microsoft's neural voices, including Nigerian English
# (en-NG-EzinneNeural, en-NG-AbeoNeural). It is an unofficial service: fine for
# a demo or pilot; for production use OpenAI, Groq, or a self-hosted Kokoro.
# TTS_BASE_URL=http://127.0.0.1:5050/v1
# TTS_VOICE=en-NG-EzinneNeural
# Per language (Hausa works out of the box with gtts:ha; Yoruba and Igbo have no free voice):
# TTS_VOICE_HA=gtts:ha
# TTS_VOICE_YO=mms:yor
# TTS_VOICE_IG=mms:ibo
# TTS_MODEL=tts-1
# TTS_API_KEY=

# --- Optional: listening in Yoruba, Hausa and Igbo on any phone --------------
# Phones' own recognisers cover these only sometimes (never on iPhone). The app
# can record a short clip and the server has a Whisper model read it, through
# the same provider as LLM_BASE_URL (Groq has a free whisper-large-v3).
# Whisper knows Yoruba and Hausa; it has no Igbo (auto-detected, experimental).
# STT_MODEL=whisper-large-v3
